# Settings for the FamHomeBase cloud display. `scripts/cloud-install.sh` creates .env for you; copy this to .env to set things up by hand.

# The absolute path of this folder.
FAMHOMEBASE_DIR=/home/pi/famhomebase-cloud

# prod or staging (staging shows a STAGING banner), and where the cloud is: https://host with no path.
FAMHOMEBASE_ENV=prod
FAMHOMEBASE_API_URL=https://famhomebase.mc-esolutions.ca

# The port you browse to. 80 by default, so the address is plain http://<address>/ (it must be free on this machine).
FAMHOMEBASE_PORT=80

# true = install new releases automatically (default). false = only log that one is available (journalctl -u famhomebase-cloud-update).
AUTO_UPDATE=true

# How often (hours, 1 to 168) the update timer looks for a release. Applies the next time cloud-host-setup.sh runs.
CHECK_INTERVAL_HOURS=6

# Screen rotation is not set here: it is a setting of the device on the website (Devices, then the device's Settings).
# Where the kiosk keeps the browser's saved data (the display's pairing and its last layout). Default ~/.local/share/famhomebase-kiosk.
# FAMHOMEBASE_PROFILE=/home/pi/.local/share/famhomebase-kiosk
