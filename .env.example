# Settings for this install. `scripts/install.sh` creates .env for you; copy this to .env if you set things up by hand.

# The absolute path of this folder. The updater needs it. (Defaults to the folder you run docker compose from.)
FAMHOMEBASE_DIR=/home/pi/famhomebase-pi

# The port you browse to. 80 by default, so the address is plain http://<address>/ (it must be free on this machine;
# if something else uses it, use e.g. 8080).
FAMHOMEBASE_PORT=80

# true = install new releases automatically (default). false = only log that one is available.
AUTO_UPDATE=true

# How often the updater checks GitHub for a new release.
CHECK_INTERVAL_HOURS=6

# Pin the app and sidecar images to a specific version. Leave unset to use the version this release was built with.
# FAMHOMEBASE_VERSION=0.1.5
