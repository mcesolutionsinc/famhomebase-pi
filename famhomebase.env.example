# Settings for the FamHomeBase display: /etc/famhomebase/famhomebase.env. The installer makes it for you and an update never
# changes it. After editing it, apply the change with: sudo systemctl restart famhomebase

# prod or staging (staging shows a STAGING banner), and where the cloud is: https://host with no path.
FAMHOMEBASE_ENV=prod
FAMHOMEBASE_API_URL=https://famhomebase.mc-esolutions.ca

# The port on this machine. 80 by default, so the address is plain http://localhost/ (it must be free on this machine).
FAMHOMEBASE_PORT=80

# The address the display listens on. 127.0.0.1 (the default) means only this machine can reach it, which is all the kiosk needs.
# Set 0.0.0.0 only to look at the display from another computer while testing, and put it back afterwards.
# FAMHOMEBASE_BIND=127.0.0.1

# true = install new releases automatically (default). false = only log that one is available (journalctl -u famhomebase-update).
AUTO_UPDATE=true

# How often (hours, 1 to 168) the update timer looks for a release. Applies the next time host-setup.sh runs.
CHECK_INTERVAL_HOURS=6

# The image, without a tag (only for one you built yourself).
# FAMHOMEBASE_IMAGE=ghcr.io/mcesolutionsinc/famhomebase-pi

# Screen rotation is not set here: it is a setting of the device on the website (Devices, then the device's Settings).
# Where the kiosk keeps the browser's saved data (the display's pairing and its last layout). Default /var/lib/famhomebase/kiosk-profile.
# FAMHOMEBASE_PROFILE=/var/lib/famhomebase/kiosk-profile
